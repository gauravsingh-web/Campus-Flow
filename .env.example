# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to mongodb://localhost:27017/campusflow; automatically falls back to in-memory MongoDB if local daemon is not running)
MONGODB_URI=mongodb://localhost:27017/campusflow

# Authentication & Security
JWT_SECRET=super_secret_campusflow_jwt_key_2026_dev_only
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
